{
  "info": {
    "name": "Simple Student API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Add student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": 108,\n  \"studentName\": \"Meera Joshi\",\n  \"email\": \"meera@example.com\",\n  \"courseName\": \"B.Tech CSE\",\n  \"programmingScore\": 82,\n  \"mathematicsScore\": 77,\n  \"technicalSkills\": [\n    \"Java\",\n    \"SQL\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Get all students",
      "request": {
        "method": "GET",
